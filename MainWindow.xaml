<Window x:Class="Afloat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Afloat" Width="1000" Height="740" MinWidth="880" MinHeight="690" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F7F7FA" FontFamily="Segoe UI, Malgun Gothic" UseLayoutRounding="True" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#DCDCE5" BorderThickness="1">
    <Grid x:Name="RootGrid">
      <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#EEEEF4" BorderBrush="#E2E2EB" BorderThickness="0,0,1,0">
        <Grid Margin="20,0"><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Width="13" Height="13" Padding="0" Background="#ED8A89" ToolTip="창 닫기" AutomationProperties.Name="창 닫기" Click="Close_Click"/>
            <Button Width="13" Height="13" Padding="0" Background="#E7C377" Margin="9,0,0,0" ToolTip="최소화" AutomationProperties.Name="최소화" Click="Minimize_Click"/>
            <Button Width="13" Height="13" Padding="0" Background="#8CBBA1" Margin="9,0,0,0" ToolTip="최대화 / 복원" AutomationProperties.Name="최대화 또는 복원" Click="Maximize_Click"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Border Width="52" Height="52" HorizontalAlignment="Left" CornerRadius="16" Margin="4,22,0,14">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A49AF6"/><GradientStop Color="#6965D7" Offset="1"/></LinearGradientBrush></Border.Background>
              <Grid><Rectangle Width="23" Height="18" RadiusX="4" RadiusY="4" Stroke="#BDB7FA" StrokeThickness="2" Margin="-6,7,0,0"/><Rectangle Width="23" Height="18" RadiusX="4" RadiusY="4" Fill="White" Margin="7,-6,0,0"/></Grid>
            </Border>
            <TextBlock Text="Afloat" FontSize="28" FontWeight="SemiBold" Margin="4,0,0,4"/>
            <TextBlock Text="작은 창, 편안한 몰입." FontSize="11" Foreground="{StaticResource Muted}" Margin="4,0,0,34"/>
            <Button x:Name="HomeNav" Click="Home_Click" Background="#DEDBF1" Foreground="#5E58AA" HorizontalContentAlignment="Left" Padding="14,13" Margin="0,0,0,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE737;" FontFamily="Segoe MDL2 Assets" Foreground="#6B65BE" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="내 공간" Foreground="#5E58AA"/></StackPanel></Button>
            <Button x:Name="SettingsNav" Click="Settings_Click" Background="Transparent" Padding="14,13"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#797B88" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="환경설정" Foreground="#696C7A"/></StackPanel></Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="4,0,4,26">
            <Border Background="#E5E3F0" CornerRadius="12" Padding="13" Margin="0,0,0,24"><StackPanel><TextBlock Text="조용히, 곁에서." FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="창을 닫아도 트레이에서&#x0a;단축키가 계속 동작해요." FontSize="11" Foreground="#797687" LineHeight="18"/></StackPanel></Border>
            <DockPanel><TextBlock Text="AFLOAT" FontSize="10" FontWeight="SemiBold" Foreground="#8A889B"/><TextBlock Text="1.1" HorizontalAlignment="Right" Foreground="#A19FAF" FontSize="10"/></DockPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="32,0,32,0">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="45"/></Grid.RowDefinitions>
        <DockPanel VerticalAlignment="Center">
          <TextBlock x:Name="PageLabel" Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#92909F" VerticalAlignment="Center"/>
          <Border HorizontalAlignment="Right" Background="#E8F3ED" CornerRadius="12" Padding="10,5"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#65A784" Margin="0,0,6,0"/><TextBlock x:Name="StatusLabel" Text="단축키 대기 중" Foreground="#59866E" FontSize="10"/></StackPanel></Border>
        </DockPanel>
        <Grid x:Name="HomePage" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="176"/><RowDefinition Height="Auto"/><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,14"><TextBlock Text="필요한 창을,&#x0a;가장 위에." FontSize="31" FontWeight="SemiBold" LineHeight="44"/><TextBlock Text="영상도, 메모도. 하던 일과 나란히." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,13,0,0"/></StackPanel>
            <Canvas Grid.Column="1" Width="240" Height="160" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
              <Ellipse Width="168" Height="140" Fill="#EFEDF9" Canvas.Left="34" Canvas.Top="8"/>
              <Border Width="160" Height="102" Background="#E0DEEC" CornerRadius="12" Canvas.Left="63" Canvas.Top="37"><StackPanel Margin="13"><Rectangle Fill="#D0CDDF" Width="43" Height="5" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"/><Rectangle Fill="#EDEBF4" Height="54" RadiusX="6" RadiusY="6" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Width="161" Height="105" Background="White" CornerRadius="12" Canvas.Left="18" Canvas.Top="19"><Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.12" Color="#665699"/></Border.Effect><Grid Margin="9"><Grid.RowDefinitions><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Ellipse Fill="#DED9EF" Width="4" Height="4" Margin="2,0"/><Ellipse Fill="#DED9EF" Width="4" Height="4" Margin="2,0"/><Ellipse Fill="#DED9EF" Width="4" Height="4" Margin="2,0"/></StackPanel><Border Grid.Row="1" CornerRadius="6"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EAE4F8"/><GradientStop Color="#B9B5E9" Offset="1"/></LinearGradientBrush></Border.Background><Grid><Ellipse Width="37" Height="37" Fill="#79FFFFFF"/><Path Data="M 0,0 L 0,15 L 12,7.5 Z" Fill="White" Width="12" Height="15" Margin="3,0,0,0"/></Grid></Border></Grid></Border>
              <Border Canvas.Left="149" Canvas.Top="4" Background="#7971D6" Width="34" Height="34" CornerRadius="11"><TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </Canvas>
          </Grid>
          <Border Grid.Row="1" Background="White" CornerRadius="18" BorderBrush="#E9E8F0" BorderThickness="1" Padding="23,20">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="고정하는 가장 가벼운 방법" FontSize="13" FontWeight="SemiBold"/><ItemsControl x:Name="ShortcutCaps" Margin="0,14,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Keycap}"><TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="원하는 창을 클릭한 뒤 누르세요. 한 번 더 누르면 해제돼요." FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
              <Button Grid.Column="1" Content="변경" Click="ChangeHotkey_Click" VerticalAlignment="Top" Margin="12,0,0,0" Padding="13,8" FontSize="11"/>
            </Grid>
          </Border>
          <DockPanel Grid.Row="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="고정된 창" FontSize="14" FontWeight="SemiBold"/><Border Background="#EAE8F3" CornerRadius="8" Margin="8,0,0,0" Padding="7,2"><TextBlock x:Name="PinCount" Text="0" FontSize="10" Foreground="#77718E"/></Border></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ReleaseAllButton" Content="모두 해제" Background="Transparent" Foreground="#8A879A" FontSize="11" Padding="9,7" Click="ReleaseAll_Click"/><Button Content="＋ 창 선택" Click="ChooseWindow_Click" Padding="12,7" FontSize="11" Margin="8,0,0,0"/></StackPanel></DockPanel>
          <Grid Grid.Row="3">
            <Border x:Name="EmptyState" Background="#F0EFF6" CornerRadius="17" BorderBrush="#E7E5EF" BorderThickness="1" MinHeight="130"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#A5A0BF" HorizontalAlignment="Center" Margin="0,0,0,13"/><TextBlock Text="위에 두고 싶은 창이 있나요?" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/><TextBlock Text="단축키를 누르거나, 창을 선택해 시작하세요." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="PinnedList"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="White" CornerRadius="13" BorderBrush="#E9E8F0" BorderThickness="1" Margin="0,0,0,9" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="#EFEDF9" CornerRadius="10" HorizontalAlignment="Left"><TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="#8276BE" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Medium" ToolTip="{Binding Title}"/><TextBlock Text="{Binding ProcessName}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding CornerLabel}" Tag="{Binding}" Click="Corner_Click" FontSize="10" Padding="10,8" ToolTip="480 × 300 크기로 왼쪽 위에 배치 / 원래 크기 복원"/><Button Content="해제" Tag="{Binding}" Click="Unpin_Click" Background="#F1EFF9" Foreground="#8074B6" FontSize="10" Padding="10,8" Margin="6,0,0,0"/></StackPanel>
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          </Grid>
        </Grid>
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Grid.Row="1">
          <TextBlock Text="편안한 쪽으로." FontSize="30" FontWeight="SemiBold" Margin="0,17,0,8"/><TextBlock Text="작업 흐름과 PC 환경에 맞게 Afloat를 조절하세요." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="18" BorderBrush="#E9E8F0" BorderThickness="1" Padding="20" Margin="0,0,8,0"><StackPanel>
              <TextBlock Text="조작과 화면" FontSize="10" FontWeight="SemiBold" Foreground="#928EA4" Margin="0,0,0,16"/>
              <DockPanel><StackPanel><TextBlock Text="고정 / 해제 단축키" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="SettingsHotkey" Text="Ctrl + Alt + Space" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button Content="변경" Click="ChangeHotkey_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" FontSize="10"/></DockPanel>
              <Border Height="1" Background="#EEEFF4" Margin="0,16"/>
              <CheckBox x:Name="NotificationToggle" Content="고정 / 해제 알림 표시" Click="Preference_Click"/><TextBlock Text="알림에 대상 창 이름도 표시해요." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
              <Border Height="1" Background="#EEEFF4" Margin="0,16"/>
              <CheckBox x:Name="AnimationToggle" Content="부드러운 애니메이션" Click="Preference_Click"/><TextBlock Text="화면 전환과 버튼 반응을 움직여 보여줘요." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
              <Border Height="1" Background="#EEEFF4" Margin="0,16"/>
              <CheckBox x:Name="RestorePlacementToggle" Content="해제할 때 원래 배치 복원" Click="Preference_Click"/><TextBlock Text="작게 배치한 창을 기존 위치와 크기로 돌려놓아요." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Grid.Column="1" Background="White" CornerRadius="18" BorderBrush="#E9E8F0" BorderThickness="1" Padding="20" Margin="8,0,0,0"><StackPanel>
              <TextBlock Text="실행과 성능" FontSize="10" FontWeight="SemiBold" Foreground="#928EA4" Margin="0,0,0,16"/>
              <CheckBox x:Name="HardwareToggle" Content="하드웨어 가속" Click="Preference_Click"/><TextBlock Text="끄면 다음 실행부터 소프트웨어 렌더링을 사용해요." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <Border Height="1" Background="#EEEFF4" Margin="0,16"/>
              <CheckBox x:Name="StartupToggle" Content="Windows 시작 시 실행" Click="Preference_Click"/><TextBlock Text="로그인하면 Afloat를 자동으로 시작해요." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
              <Border Height="1" Background="#EEEFF4" Margin="0,16"/>
              <CheckBox x:Name="StartHiddenToggle" Content="자동 시작 시 트레이에서 시작" Click="Preference_Click"/><TextBlock Text="Windows 로그인 후 메인 창을 띄우지 않아요." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <Border Height="1" Background="#EEEFF4" Margin="0,16"/>
              <CheckBox x:Name="TrayToggle" Content="닫기 버튼을 누르면 트레이로" Click="Preference_Click"/><TextBlock Text="아이콘을 더블 클릭하면 다시 열려요." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
            </StackPanel></Border>
          </Grid>
          <Border CornerRadius="14" Background="#EFEDF7" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="게임과 함께 사용할 때" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="테두리 없는 창 모드를 사용하세요. 독점 전체 화면과 관리자 권한 창은 제한될 수 있어요." FontSize="10" Foreground="#807A94" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <DockPanel Margin="0,16,0,0"><TextBlock Text="종료하면 Afloat로 고정한 창이 모두 해제돼요." FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="Afloat 종료" Click="Exit_Click" HorizontalAlignment="Right" FontSize="10" Padding="12,7"/></DockPanel>
        </StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Footer" Text="나머지는 그대로. 필요한 것만 가까이." FontSize="10" Foreground="#9592A5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
          <TextBlock Grid.Column="1" Text="· 이 앱은 ChatGPT를 통해 제작되었습니다." FontSize="9" Foreground="#AAA8B5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </Grid>
      <Grid x:Name="Modal" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#660E1020" MouseDown="Modal_MouseDown" KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="ModalCard" Width="520" MaxHeight="580" Background="#FAFAFD" CornerRadius="22" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="Dialog_MouseDown" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform><Grid>
          <StackPanel x:Name="HotkeyDialog" Visibility="Collapsed">
            <TextBlock Text="손에 익은 단축키로." FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Ctrl 또는 Alt를 포함한 조합을 직접 눌러 주세요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,22"/>
            <Border Background="#EFEDF8" CornerRadius="14" Padding="25"><TextBlock x:Name="CaptureLabel" Text="단축키 입력 대기 중…" HorizontalAlignment="Center" FontSize="21" Foreground="#7770B3"/></Border>
            <TextBlock x:Name="CaptureHint" Text="예: Ctrl + Alt + Space · Esc를 누르면 취소" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,25"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" Click="CancelModal_Click" Margin="0,0,8,0"/><Button x:Name="SaveHotkeyButton" Content="단축키 저장" Style="{StaticResource Primary}" IsEnabled="False" IsDefault="True" Click="SaveHotkey_Click"/></StackPanel>
          </StackPanel>
          <Grid x:Name="PickerDialog" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="어떤 창을 띄워둘까요?" FontSize="23" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="목록에서 고정할 창을 선택하세요." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,22"/>
            <Grid Grid.Row="2" MinHeight="100"><ScrollViewer MaxHeight="345" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="WindowPicker"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="Pick_Click" Background="White" Margin="0,0,0,7" Padding="15" HorizontalContentAlignment="Stretch"><Grid Width="390"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Initial}" FontSize="16" Foreground="#9387C5" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding ProcessName}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="PickerEmpty" Text="선택할 창이 없어요. 앱을 하나 열어 주세요." Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/></Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="새로고침" Click="RefreshPicker_Click" Margin="0,0,8,0"/><Button Content="닫기" Click="CancelModal_Click"/></StackPanel>
          </Grid>
        </Grid></Border>
      </Grid>
    </Grid>
  </Border>
</Window>

